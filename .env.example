# Copy to .env for local dev. On Vercel, set this in Project Settings → Environment Variables.
# The deployed Cloudflare Worker image proxy URL (Phase 0).
# If unset, the app falls back to http://127.0.0.1:8787 (local wrangler dev).
VITE_IMAGE_PROXY=https://yomu-image-proxy.<your-subdomain>.workers.dev
